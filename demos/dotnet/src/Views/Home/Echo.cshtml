@model CaptchaSample.Models.EchoViewModel
@{
    ViewData["Title"] = "RESTCaptcha .NET Demo Echo";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="h4 text-center mb-4">@ViewData["Title"]</h2>
        <div class="alert alert-warning" role="alert">
            Below is an echo of what you entered. Do not use real credentials.
        </div>
        <div class="card shadow">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">User name</dt>
                    <dd class="col-sm-8">@Model.Username</dd>

                    <dt class="col-sm-4">Password</dt>
                    <dd class="col-sm-8">@Model.Password</dd>

                    <dt class="col-sm-4">Verification status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>
                </dl>
                <a href="@Model.ReturnUrl" class="btn btn-secondary">Back</a>
            </div>
        </div>
    </div>
</div>